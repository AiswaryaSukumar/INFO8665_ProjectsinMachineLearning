# Copy this file to .env and fill in real values
# NEVER commit .env with real credentials

# ---------- Database (individual secrets preferred over monolithic URL) ----------
DB_USERNAME=user
DB_PASSWORD=password
DB_HOSTNAME=localhost
DB_PORT=5432
DB_NAME=neondb
DB_SSLMODE=require

# Backward-compatible monolithic URL (overrides individual parts if set)
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname?sslmode=require

# ---------- ML Experiment ----------
EXPERIMENT_NAME=insight311_category_classifier
EXPERIMENT_VERSION=1.0.0

# ---------- ML Hyperparameters ----------
MODEL_NAME=distilbert-base-uncased
NUM_LABELS=11
MAX_SEQ_LENGTH=128
NUM_EPOCHS=15
BATCH_SIZE=8
LEARNING_RATE=2e-5
WEIGHT_DECAY=0.01
EXPECTED_ACCURACY=0.95

# ---------- Confidence Thresholds ----------
CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_MEDIUM_THRESHOLD=0.50
CATEGORY_HIGH_THRESHOLD=0.60
CATEGORY_MEDIUM_THRESHOLD=0.35
REVIEW_THRESHOLD=0.60
CLARIFICATION_THRESHOLD=0.3
UI_LOW_CONFIDENCE_THRESHOLD=0.5

# ---------- STT / Whisper ----------
WHISPER_MODEL_SIZE=small

# ---------- Application ----------
APP_PORT=8311
LOG_LEVEL=INFO
