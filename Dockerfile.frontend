FROM node:20-alpine AS builder

WORKDIR /app
COPY frontend-ui/web-agent/package*.json ./
RUN npm ci
COPY frontend-ui/web-agent/ ./
RUN npm run build

FROM nginx:alpine
COPY frontend-ui/web-agent/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
